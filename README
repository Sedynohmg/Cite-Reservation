async function toggleReservationStarted(reservationId, isStarted) {

    try {

        const { error } = await supabaseClient
            .from("reservations")
            .update({
                is_started: isStarted
            })
            .eq("id", reservationId);

        if (error) {
            throw error;
        }

        console.log(
            isStarted
                ? "Réservation commencée."
                : "Réservation remise en attente."
        );

        await loadReservations();
        await loadRecentReservations();
        await updateDashboardStats();

    } catch (error) {

        console.error(
            "Erreur démarrage réservation :",
            error
        );

        alert(
            "Impossible de modifier le statut de la réservation."
        );
    }
}