async function openReservation(activity = "") {
    if (!currentUser) {
        showAuth();
        return;
    }

    const modal = document.getElementById("reservationModal");
    if (!modal) {
        return;
    }

    const activityInput = document.getElementById("activity");

    if (activityInput && activity) {
        activityInput.value = activity;
    }

    selectedDate = null;
    selectedTime = null;

    const dateInput = document.getElementById("date");
    const timeInput = document.getElementById("time");

    if (dateInput) {
        dateInput.value = "";
    }

    if (timeInput) {
        timeInput.value = "";
    }

    resetSubmitButton();

    // AFFICHER LE MODAL IMMÉDIATEMENT
    modal.classList.remove("hidden");
    modal.classList.add("flex");
    document.body.classList.add("overflow-hidden");

    // Affichage immédiat du calendrier
    renderCalendar();

    // Affichage des créneaux
    renderTimeSlots();

    // Charger les réservations du mois en arrière-plan
    await loadCalendarReservations();
}